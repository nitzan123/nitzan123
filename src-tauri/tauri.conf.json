{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Studio",
  "version": "0.1.0",
  "identifier": "dev.prism-studio.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prism Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: prism: http://prism.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Photo manager and non-destructive RAW editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Prism Studio",
    "copyright": "Copyright © 2026 Prism Studio contributors. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "longDescription": "Prism Studio is a photo manager and non-destructive RAW editor: catalog, ratings and keywords, full-resolution RAW development with lens correction, local adjustments with brush and AI masks, heal/clone retouching, on-device face recognition and smart search, folder/calendar/map views, and batch export with metadata.",
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "tif",
          "tiff",
          "webp",
          "cr2",
          "cr3",
          "nef",
          "arw",
          "dng",
          "orf",
          "rw2",
          "raf",
          "pef",
          "srw"
        ],
        "name": "Photo",
        "role": "Viewer"
      }
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "graphics"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
