{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Studio",
  "version": "0.1.0",
  "identifier": "dev.prism-studio.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prism Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: prism: http://prism.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Photo manager and non-destructive RAW editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Prism Studio",
    "copyright": "Copyright © 2026 Prism Studio contributors. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "longDescription": "Prism Studio is a photo manager and non-destructive RAW editor: catalog, ratings and keywords, full-resolution RAW development with lens correction, local adjustments with brush and AI masks, heal/clone retouching, on-device face recognition and smart search, folder/calendar/map views, and batch export with metadata.",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "name": "JPEG image",
        "description": "JPEG image",
        "role": "Viewer"
      },
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "name": "PNG image",
        "description": "PNG image",
        "role": "Viewer"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "mimeType": "image/tiff",
        "name": "TIFF image",
        "description": "TIFF image",
        "role": "Viewer"
      },
      {
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "name": "WebP image",
        "description": "WebP image",
        "role": "Viewer"
      },
      {
        "ext": [
          "dng"
        ],
        "mimeType": "image/x-adobe-dng",
        "name": "DNG raw",
        "description": "DNG raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "cr2"
        ],
        "mimeType": "image/x-canon-cr2",
        "name": "Canon raw",
        "description": "Canon raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "cr3"
        ],
        "mimeType": "image/x-canon-cr3",
        "name": "Canon raw",
        "description": "Canon raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "nef"
        ],
        "mimeType": "image/x-nikon-nef",
        "name": "Nikon raw",
        "description": "Nikon raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "arw"
        ],
        "mimeType": "image/x-sony-arw",
        "name": "Sony raw",
        "description": "Sony raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "orf"
        ],
        "mimeType": "image/x-olympus-orf",
        "name": "Olympus raw",
        "description": "Olympus raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "rw2"
        ],
        "mimeType": "image/x-panasonic-rw2",
        "name": "Panasonic raw",
        "description": "Panasonic raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "raf"
        ],
        "mimeType": "image/x-fuji-raf",
        "name": "Fujifilm raw",
        "description": "Fujifilm raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "pef"
        ],
        "mimeType": "image/x-pentax-pef",
        "name": "Pentax raw",
        "description": "Pentax raw",
        "role": "Viewer"
      },
      {
        "ext": [
          "srw"
        ],
        "mimeType": "image/x-samsung-srw",
        "name": "Samsung raw",
        "description": "Samsung raw",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/prism-studio.desktop",
        "section": "graphics"
      },
      "rpm": {
        "desktopTemplate": "linux/prism-studio.desktop"
      }
    }
  }
}
